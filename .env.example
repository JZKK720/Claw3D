# Browser/client gateway URL (build-time — requires `npm run build` after changes)
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789

# Runtime gateway URL — takes effect on restart without a rebuild.
# Use this instead of NEXT_PUBLIC_GATEWAY_URL when you want to change the
# gateway endpoint without re-running `npm run build`.
# CLAW3D_GATEWAY_URL=ws://localhost:18789
# CLAW3D_GATEWAY_TOKEN=
# CLAW3D_GATEWAY_TOKEN_FILE=.secrets/openclaw-gateway-token
# Optional: tell Studio which backend that runtime gateway URL represents.
# Valid values: openclaw, hermes, demo, custom
# Valid values: openclaw, ironclaw, hermes, demo, local, claw3d, custom
# CLAW3D_GATEWAY_ADAPTER_TYPE=openclaw


# HERMES_API_URL=http://localhost:8642
# HERMES_ADAPTER_API_URL=http://host.docker.internal:8642
# HERMES_API_KEY=change-me-local-dev
# HERMES_API_KEY_FILE=.secrets/hermes-api-key
# HERMES_ADAPTER_BIND_HOST=127.0.0.1
# HERMES_MODEL=hermes-agent

# Debug UI
DEBUG=true

# App server
# PORT=3000
# HOST=127.0.0.1

# Optional: required only for public/remote deployments
# STUDIO_ACCESS_TOKEN=
# Local Docker opt-in for /studio-access through the Docker bridge. Do not use
# this on publicly reachable binds.
# STUDIO_ACCESS_LOCAL_HELPER=1
# When Claw3D runs in Docker and your runtimes stay on the host, allow those
# upstream hosts explicitly.
# UPSTREAM_ALLOWLIST=host.docker.internal,localhost,127.0.0.1
# Custom runtime host allowlist. If unset, Claw3D falls back to
# UPSTREAM_ALLOWLIST for /api/runtime/custom.
# CUSTOM_RUNTIME_ALLOWLIST=host.docker.internal,localhost,127.0.0.1
# Override the default OpenClaw state/config paths when needed.
# OPENCLAW_STATE_DIR=
# OPENCLAW_CONFIG_PATH=
# Advanced only: some gateway-host operations can still use SSH, but marketplace skill install does not require it.
# OPENCLAW_GATEWAY_SSH_TARGET=
# OPENCLAW_GATEWAY_SSH_USER=
# OPENCLAW_GATEWAY_SSH_PORT=
# OPENCLAW_GATEWAY_SSH_STRICT_HOST_KEY_CHECKING=accept-new

# Hermes Agent adapter (alternative to OpenClaw)
# Run `npm run hermes-adapter` to start the adapter.
# When Studio runs in Docker and the adapter stays on the host, set
# HERMES_ADAPTER_HOST=host.docker.internal.
# HERMES_API_URL=http://localhost:8642
# HERMES_API_KEY=
# HERMES_ADAPTER_HOST=localhost
# HERMES_ADAPTER_PORT=18791
# HERMES_MODEL=hermes
# HERMES_AGENT_NAME=Hermes
# If CLAW3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# Demo gateway (no OpenClaw or Hermes required)
# Run `npm run demo-gateway` and connect Claw3D to ws://localhost:18792
# DEMO_ADAPTER_HOST=localhost
# DEMO_ADAPTER_PORT=18792
# If CLAW3D_GATEWAY_URL is unset, Studio can still detect this local adapter port.

# IronClaw HTTP runtime (first-class backend in Studio)
# Point Claw3D at the IronClaw app/gateway URL and use the gateway token when bearer auth is enabled.
# IRONCLAW_GATEWAY_URL=http://localhost:3231
# IRONCLAW_GATEWAY_TOKEN=
# IRONCLAW_GATEWAY_TOKEN_FILE=.secrets/ironclaw-gateway-token

# Optional: voice features
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
